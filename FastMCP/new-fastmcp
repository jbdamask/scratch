#!/bin/bash

# Check if the project name parameter is provided
if [ -z "$1" ]; then
    echo "Error: Please provide a project name."
    echo "Usage: create-mcp-project <project-name>"
    exit 1
fi

# Store the project name from parameter
PROJECT_NAME="$1"

# Execute the commands
uv init --python 3.12 "$PROJECT_NAME"
cd "$PROJECT_NAME"
uv venv
source .venv/bin/activate
uv pip install fastmcp
#uv add "mcp[cli]" httpx
# touch "$PROJECT_NAME.py"
touch .env
echo ".env*" >> .gitignore
echo ".vscode" >> .gitignore

# Write the specified content to the project's Python file
cat > "$PROJECT_NAME.py" << 'EOF'
# server.py
from fastmcp import FastMCP
# Create an MCP server
mcp = FastMCP("Demo")
# Add an addition tool
@mcp.tool()
def add(a: int, b: int) -> int:
    """Add two numbers"""
    return a + b
# Add a dynamic greeting resource
@mcp.resource("greeting://{name}")
def get_greeting(name: str) -> str:
    """Get a personalized greeting"""
    return f"Hello, {name}!"
EOF

mkdir instructions
curl https://raw.githubusercontent.com/jbdamask/scratch/refs/heads/main/MCP/mcp-api-template.py > instructions/mcp-api-template.py

echo "Project $PROJECT_NAME has been created successfully!"